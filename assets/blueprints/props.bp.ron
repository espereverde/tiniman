// Stage props. Like enemies, an LDtk entity named e.g. `Exit` spawns the blueprint "exit".
{
    // Reaching it clears the room. Locked while any enemy is alert: kill them (or lose them)
    // to open it.
    "exit": (
        components: {
            "Name": "Exit",
            "Exit": (half_size: (x: 4.0, y: 7.0)),
            "SpriteSheet": (
                image: Path("/sprites/props.png"),
                tile_size: (16, 16),
                columns: 2,
                rows: 1,
                padding: (2, 2),
            ),
        },
    ),
}
